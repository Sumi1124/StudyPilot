<Window x:Class="StudyPilot.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StudyPilot for Windows" Width="1240" Height="820" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing">
  <Window.Resources>
    <DataTemplate x:Key="AssignmentTemplate">
      <Border BorderBrush="#EBF0EC" BorderThickness="0,0,0,1" Padding="12,14">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <CheckBox IsChecked="{Binding IsDone, Mode=OneWay}" Click="CompleteAssignment_Click" VerticalAlignment="Center" Tag="{Binding Id}"/>
          <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
          <Border Grid.Column="2" Background="{StaticResource AccentSoftBrush}" CornerRadius="8" Padding="10,5" Margin="12,0" VerticalAlignment="Center"><TextBlock Text="{Binding DueLabel}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="11"/></Border>
          <Button Grid.Column="3" Content="Delete" Padding="10,6" Tag="{Binding Id}" Click="DeleteAssignment_Click"/>
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="BlockTemplate">
      <Border BorderBrush="#EBF0EC" BorderThickness="0,0,0,1" Padding="12,14">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <CheckBox IsChecked="{Binding IsDone, Mode=OneWay}" Click="CompleteBlock_Click" Tag="{Binding Id}" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding TimeLabel}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
          <Border Grid.Column="2" Background="#F1F4F2" CornerRadius="8" Padding="9,5" Margin="10,0"><TextBlock Text="{Binding DurationLabel}" Foreground="{StaticResource MutedBrush}" FontSize="11"/></Border>
          <Button Grid.Column="3" Content="Move" Padding="10,6" Margin="4,0" Tag="{Binding Id}" Click="MoveBlock_Click"/>
          <Button Grid.Column="4" Content="Delete" Padding="10,6" Margin="4,0,0,0" Tag="{Binding Id}" Click="DeleteBlock_Click"/>
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="NoteTemplate">
      <Border Background="White" BorderBrush="#E5EBE6" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,11">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Preview}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,7,20,5"/><TextBlock Text="{Binding UpdatedLabel}" Foreground="#8B9791" FontSize="10"/></StackPanel>
          <Button Grid.Column="1" Content="Delete" Padding="10,6" Tag="{Binding Id}" Click="DeleteNote_Click" VerticalAlignment="Top"/>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#1E2924" Padding="18,22">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="5,0,0,31">
            <Border Width="38" Height="38" CornerRadius="12" Background="#C8E3D3"><TextBlock Text="SP" Foreground="#285B47" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <StackPanel Margin="11,1,0,0"><TextBlock Text="StudyPilot" Foreground="White" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="STUDENT WORKSPACE" Foreground="#91A299" FontSize="9"/></StackPanel>
          </StackPanel>
          <TextBlock Text="WORKSPACE" Foreground="#788B81" FontSize="9" FontWeight="SemiBold" Margin="12,0,0,9"/>
          <Button x:Name="TodayNav" Content="⌂   Today" Style="{StaticResource NavButton}" Click="Today_Click"/>
          <Button x:Name="AssignmentsNav" Content="☑   Assignments" Style="{StaticResource NavButton}" Click="Assignments_Click"/>
          <Button x:Name="PlannerNav" Content="▦   Study plan" Style="{StaticResource NavButton}" Click="Planner_Click"/>
          <Button x:Name="NotesNav" Content="▤   Notes" Style="{StaticResource NavButton}" Click="Notes_Click"/>
          <Button x:Name="FocusNav" Content="◷   Focus" Style="{StaticResource NavButton}" Click="Focus_Click"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <Button x:Name="SettingsNav" Content="⚙   Settings &amp; data" Style="{StaticResource NavButton}" Click="Settings_Click"/>
          <Border Height="1" Background="#35453D" Margin="5,10,5,14"/>
          <TextBlock Text="Windows edition · 1.0.0" Foreground="#9AABA2" FontSize="10" Margin="10,0,0,4"/>
          <TextBlock Text="Private and local by default" Foreground="#71837A" FontSize="10" Margin="10,0,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="90"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Background="#FAFBFA" BorderBrush="#E4EAE5" BorderThickness="0,0,0,1" Padding="34,0">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center"><TextBlock x:Name="ViewTitle" Text="Today" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="ViewSubtitle" Text="Your work, shaped into a clear day." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="DateLabel" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/><Button x:Name="QuickAddButton" Content="＋ New assignment" Style="{StaticResource PrimaryButton}" Click="AddAssignment_Click"/></StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="34,28,34,30">
        <ScrollViewer x:Name="TodayView" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border x:Name="RescheduleNotice" Background="#FFF6DB" CornerRadius="11" Padding="14,10" Margin="0,0,0,18" Visibility="Collapsed"><TextBlock x:Name="RescheduleNoticeText" Foreground="#765B12"/></Border>
            <UniformGrid Columns="4" Margin="0,0,0,24">
              <Border Background="White" CornerRadius="15" Padding="18" Margin="0,0,9,0"><StackPanel><TextBlock Text="DUE SOON" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="SemiBold"/><TextBlock x:Name="DueCount" Text="0" FontSize="29" FontWeight="SemiBold" Margin="0,8,0,2"/><TextBlock Text="next seven days" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel></Border>
              <Border Background="White" CornerRadius="15" Padding="18" Margin="3,0,6,0"><StackPanel><TextBlock Text="STUDY BLOCKS" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="SemiBold"/><TextBlock x:Name="BlockCount" Text="0" FontSize="29" FontWeight="SemiBold" Margin="0,8,0,2"/><TextBlock Text="still to complete" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel></Border>
              <Border Background="White" CornerRadius="15" Padding="18" Margin="6,0,3,0"><StackPanel><TextBlock Text="COMPLETED" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="SemiBold"/><TextBlock x:Name="DoneCount" Text="0" FontSize="29" FontWeight="SemiBold" Margin="0,8,0,2"/><TextBlock Text="assignments finished" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel></Border>
              <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="15" Padding="18" Margin="9,0,0,0"><StackPanel><TextBlock Text="FOCUS" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="SemiBold"/><TextBlock x:Name="FocusMinutesLabel" Text="0 min" FontSize="24" FontWeight="SemiBold" Margin="0,10,0,4"/><TextBlock Text="completed locally" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel></Border>
            </UniformGrid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
              <StackPanel><DockPanel Margin="0,0,0,11"><TextBlock Text="Assignments to move forward" FontSize="18" FontWeight="SemiBold"/><Button DockPanel.Dock="Right" Content="Add" Padding="11,5" Click="AddAssignment_Click"/></DockPanel><Border Background="White" CornerRadius="15" Padding="7"><ListView x:Name="TodayAssignmentList" ItemTemplate="{StaticResource AssignmentTemplate}" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Disabled"/></Border><TextBlock x:Name="TodayEmpty" Text="Nothing due soon. Add an assignment when you are ready." Foreground="{StaticResource MutedBrush}" TextAlignment="Center" Margin="0,24" Visibility="Collapsed"/></StackPanel>
              <StackPanel Grid.Column="2"><DockPanel Margin="0,0,0,11"><TextBlock Text="Next study blocks" FontSize="18" FontWeight="SemiBold"/><Button DockPanel.Dock="Right" Content="Plan" Padding="11,5" Click="Planner_Click"/></DockPanel><Border Background="White" CornerRadius="15" Padding="7"><ListView x:Name="TodayBlockList" ItemTemplate="{StaticResource BlockTemplate}" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Disabled"/></Border><TextBlock x:Name="TodayBlocksEmpty" Text="No study blocks yet. Generate a plan in one click." Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="15,24" Visibility="Collapsed"/></StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>

        <Grid x:Name="AssignmentsView" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,16"><Button DockPanel.Dock="Right" Content="＋ Add assignment" Style="{StaticResource PrimaryButton}" Click="AddAssignment_Click"/><TextBox x:Name="AssignmentSearch" Width="310" HorizontalAlignment="Left" TextChanged="AssignmentSearch_TextChanged" ToolTip="Search by title or subject"/><TextBlock Text="Search assignments" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0"/></DockPanel>
          <StackPanel Grid.Row="1"><Border Background="White" CornerRadius="15" Padding="8"><ListView x:Name="AssignmentList" ItemTemplate="{StaticResource AssignmentTemplate}" BorderThickness="0" Background="Transparent"/></Border><TextBlock x:Name="AssignmentEmpty" Text="No matching assignments." Foreground="{StaticResource MutedBrush}" TextAlignment="Center" Margin="0,30" Visibility="Collapsed"/></StackPanel>
        </Grid>

        <Grid x:Name="PlannerView" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="15" Padding="20" Margin="0,0,0,18"><DockPanel><Button DockPanel.Dock="Right" Content="Build my plan" Style="{StaticResource PrimaryButton}" Click="GeneratePlan_Click"/><StackPanel><TextBlock Text="A practical plan from your own assignments" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="StudyPilot uses priority, due date, and your time estimate. Sessions stay on this PC." Foreground="{StaticResource MutedBrush}" Margin="0,5,20,0"/></StackPanel></DockPanel></Border>
          <DockPanel Grid.Row="1" Margin="0,0,0,11"><TextBlock Text="Scheduled study blocks" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="PlanSummary" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/></DockPanel>
          <StackPanel Grid.Row="2"><Border Background="White" CornerRadius="15" Padding="8"><ListView x:Name="BlockList" ItemTemplate="{StaticResource BlockTemplate}" BorderThickness="0" Background="Transparent"/></Border><TextBlock x:Name="PlanEmpty" Text="No study blocks yet. Add assignments, then build your plan." Foreground="{StaticResource MutedBrush}" TextAlignment="Center" Margin="0,30" Visibility="Collapsed"/></StackPanel>
        </Grid>

        <Grid x:Name="NotesView" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,16"><Button DockPanel.Dock="Right" Content="＋ New note" Style="{StaticResource PrimaryButton}" Click="AddNote_Click"/><StackPanel><TextBlock Text="Your own thinking, easy to find" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Keep class notes and revision ideas together." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel></DockPanel>
          <StackPanel Grid.Row="1"><ListView x:Name="NoteList" ItemTemplate="{StaticResource NoteTemplate}" BorderThickness="0" Background="Transparent"/><TextBlock x:Name="NotesEmpty" Text="No notes yet. Start with one useful idea from class." Foreground="{StaticResource MutedBrush}" TextAlignment="Center" Margin="0,30" Visibility="Collapsed"/></StackPanel>
        </Grid>

        <Grid x:Name="FocusView" Visibility="Collapsed">
          <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
          <Border Background="White" CornerRadius="18" Padding="36"><StackPanel VerticalAlignment="Center"><TextBlock Text="FOCUS SESSION" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Center"/><TextBlock x:Name="TimerLabel" Text="25:00" FontSize="72" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,24,0,20"/><ProgressBar x:Name="TimerProgress" Minimum="0" Maximum="1500" Value="0" Height="7" Foreground="{StaticResource AccentBrush}" Background="#E8EDE9" BorderThickness="0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0"><Button x:Name="StartPauseButton" Content="Start" Style="{StaticResource PrimaryButton}" Width="100" Click="StartPause_Click"/><Button Content="Reset" Width="90" Margin="10,0,0,0" Click="ResetTimer_Click"/></StackPanel></StackPanel></Border>
          <StackPanel Grid.Column="2"><Border Background="{StaticResource AccentSoftBrush}" CornerRadius="16" Padding="22" Margin="0,0,0,16"><StackPanel><TextBlock Text="What are you working on?" FontSize="16" FontWeight="SemiBold"/><ComboBox x:Name="FocusTaskPicker" DisplayMemberPath="Title" Margin="0,14,0,0"/></StackPanel></Border><Border Background="White" CornerRadius="16" Padding="22"><StackPanel><TextBlock Text="A small focus ritual" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="1. Choose one assignment.&#x0a;2. Put distractions away.&#x0a;3. Work until the timer ends.&#x0a;4. Take a short break." Foreground="{StaticResource MutedBrush}" LineHeight="25" Margin="0,12,0,0"/><TextBlock Text="Focus time is stored only after a session finishes." Foreground="#8A9690" FontSize="10" TextWrapping="Wrap" Margin="0,18,0,0"/></StackPanel></Border></StackPanel>
        </Grid>

        <Grid x:Name="SettingsView" Visibility="Collapsed">
          <StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <Border Background="White" CornerRadius="16" Padding="22" Margin="0,0,0,16"><StackPanel><TextBlock Text="Your data" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Assignments, notes, plans, and focus totals are stored locally in one JSON workspace." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/><TextBlock x:Name="DataPathLabel" Foreground="#87938D" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,13,0,16"/><StackPanel Orientation="Horizontal"><Button Content="Export backup" Style="{StaticResource PrimaryButton}" Click="Export_Click"/><Button Content="Import backup" Margin="10,0,0,0" Click="Import_Click"/><Button Content="Open data folder" Margin="10,0,0,0" Click="OpenDataFolder_Click"/></StackPanel></StackPanel></Border>
            <Border Background="White" CornerRadius="16" Padding="22"><StackPanel><TextBlock Text="About StudyPilot for Windows" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Version 1.0.0 · Native WPF desktop application" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/><TextBlock Text="This Windows edition is maintained separately from StudyPilot for macOS. It does not change, replace, or share the macOS app's release version." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border>
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
