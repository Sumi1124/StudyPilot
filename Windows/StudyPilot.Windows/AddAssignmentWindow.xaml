<Window x:Class="StudyPilot.Windows.AddAssignmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New assignment" Width="460" Height="530" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
  <Grid Margin="30">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="New assignment" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock Text="Add the details StudyPilot needs to build a realistic plan." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,24"/>
    </StackPanel>
    <StackPanel Grid.Row="1">
      <TextBlock Text="TITLE" Style="{StaticResource FieldLabel}"/>
      <TextBox x:Name="TitleInput" FontSize="14"/>
      <TextBlock Text="SUBJECT" Style="{StaticResource FieldLabel}" Margin="0,17,0,6"/>
      <TextBox x:Name="SubjectInput" Text="General"/>
      <Grid Margin="0,17,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="DUE DATE" Style="{StaticResource FieldLabel}"/><DatePicker x:Name="DueInput"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="PRIORITY" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="PriorityInput" SelectedIndex="1"><ComboBoxItem Content="Low"/><ComboBoxItem Content="Medium"/><ComboBoxItem Content="High"/></ComboBox></StackPanel>
      </Grid>
      <TextBlock Text="ESTIMATED STUDY TIME" Style="{StaticResource FieldLabel}" Margin="0,17,0,6"/>
      <ComboBox x:Name="EstimateInput" SelectedIndex="2">
        <ComboBoxItem Content="30 minutes" Tag="30"/><ComboBoxItem Content="45 minutes" Tag="45"/><ComboBoxItem Content="1 hour" Tag="60"/><ComboBoxItem Content="1.5 hours" Tag="90"/><ComboBoxItem Content="2 hours" Tag="120"/><ComboBoxItem Content="3 hours" Tag="180"/>
      </ComboBox>
    </StackPanel>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
      <Button Content="Cancel" IsCancel="True" Margin="0,0,9,0"/>
      <Button Content="Add assignment" Click="Save_Click" Style="{StaticResource PrimaryButton}"/>
    </StackPanel>
  </Grid>
</Window>
